# =====================================================================
# SwiftDrive Rentals — Server Environment Configuration
# Negombo, Sri Lanka Fleet & Reservation Engine
# =====================================================================

PORT=5001
NODE_ENV=development
TRUST_PROXY=false

# ---------------------------------------------------------------------
# JWT Authentication Configuration
# In production (NODE_ENV=production), a cryptographically secure random secret
# with a minimum of 32 characters is strictly required at server startup.
# Example generator: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------
JWT_SECRET=your_minimum_32_character_cryptographically_secure_jwt_secret_here

# ---------------------------------------------------------------------
# Rate Limiting Configuration (Optional Overrides)
# ---------------------------------------------------------------------
# LOGIN_RATE_LIMIT_WINDOW_MS=900000   # 15 minutes
# LOGIN_RATE_LIMIT_MAX=10             # Max 10 attempts per window
# REGISTER_RATE_LIMIT_WINDOW_MS=3600000 # 1 hour
# REGISTER_RATE_LIMIT_MAX=5           # Max 5 registrations per window

# ---------------------------------------------------------------------
# Supabase PostgreSQL Database Integration
# Project: https://ufogqgdrzmoptvfuidxh.supabase.co
# ---------------------------------------------------------------------
SUPABASE_URL=https://ufogqgdrzmoptvfuidxh.supabase.co

# Supabase Anon Public Key (Found in Supabase Dashboard > Project Settings > API)
SUPABASE_ANON_KEY=

# Supabase Service Role Secret Key (Found in Supabase Dashboard > Project Settings > API)
# Required for server-side admin operations and automated schema synchronization
SUPABASE_SERVICE_ROLE_KEY=

# Direct PostgreSQL Connection URI (Optional: for direct pg drivers / Prisma / migrations)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.ufogqgdrzmoptvfuidxh.supabase.co:5432/postgres
